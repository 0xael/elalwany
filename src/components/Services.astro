---
import { BrainCircuit, DollarSign, ShieldCheck, GitBranch, Radio, Cloud } from "lucide-astro";

const services = [
    {
        title: 'AI Adoption',
        description: 'Transform your business to become fully AI managed.',
        Icon: BrainCircuit,
    },
    {
        title: 'Revenue Generation',
        description: 'Engineering solutions that drive revenue. Any industry.',
        Icon: DollarSign,
    },
    {
        title: 'Cloud Security',
        description: 'Vulnerability scanning, security tooling, and defensible pipelines.',
        Icon: ShieldCheck,
    },
    {
        title: 'GitOps & IaC',
        description: 'Reproducible deployments with Flux, Helm, and Terraform.',
        Icon: GitBranch,
    },
    {
        title: 'Event-Driven Systems',
        description: 'High-throughput services with Kafka and caching at scale.',
        Icon: Radio,
    },
    {
        title: 'Cloud Architecture',
        description: 'Resilient infrastructure on Hyperscalers (AWS, Azure, GCP) and Kubernetes.',
        Icon: Cloud,
    },
];
---
<section id="services" class="scroll-mt-20 border-t border-[var(--border-color)] py-20">
    <h2 class="mb-4 text-sm font-medium uppercase tracking-widest text-[var(--accent)]">What I build for clients</h2>
    <p class="mb-10 max-w-2xl text-lg text-[var(--text-secondary)]">
        Need help shipping something secure and scalable? These are the areas I work in.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
            <div class="group rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-6 transition-all duration-200 hover:border-[var(--accent)] hover:-translate-y-1">
                <div class="mb-4 inline-flex rounded-xl bg-[var(--accent)]/10 p-3 text-[var(--accent)] transition-colors group-hover:bg-[var(--accent)]/20">
                    <service.Icon size={24} />
                </div>
                <h3 class="mb-2 text-lg font-semibold text-[var(--text-primary)]">{service.title}</h3>
                <p class="text-sm text-[var(--text-secondary)]">{service.description}</p>
            </div>
        ))}
    </div>
</section>
