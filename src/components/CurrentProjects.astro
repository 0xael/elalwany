---
const highlights = [
    'Co-developed the Application Vulnerability Report (AVR) — a platform-wide service scanning runtime applications across Cloud Foundry to surface open-source vulnerabilities at SAP scale, now part of SAP’s All-in on AI initiative.',
    'Co-architected AVR’s scanning pipeline with a Kafka ingestion layer and Redis caching tier, improving scan throughput and cutting end-to-end detection latency.',
    'Designed and operate GitOps pipelines on BTP and Gardener with Helm, Flux, and Kustomize for reproducible, audit-friendly deployments.',
    'Contributing to SAP\'s open-source <a href="https://sap.github.io/crossplane-provider-docs/" target="_blank" class="underline">Crossplane Providers</a> — Kubernetes-native controllers that let teams provision and manage SAP BTP services declaratively through the Crossplane control plane. Owner of the AI Core Provider.',
];
---
<section id="now" class="scroll-mt-20 border-t border-[var(--border-color)] py-20">
    <h2 class="mb-8 text-sm font-medium uppercase tracking-widest text-[var(--accent)]">Currently</h2>
    <div class="max-w-2xl">
        <div class="mb-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="text-2xl font-semibold text-[var(--text-primary)]">Software Engineer</h3>
            <span class="text-lg text-[var(--text-secondary)]">&middot; SAP</span>
        </div>
        <ul class="space-y-4">
            {highlights.map((item) => (
                <li class="flex gap-3 text-[var(--text-secondary)]">
                    <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]"></span>
                    <span set:html={item} />
                </li>
            ))}
        </ul>
    </div>
</section>
