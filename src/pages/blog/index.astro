---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title="Blog — Aly Elalwany" description="Thoughts on cloud infrastructure, security, and software engineering." icon="/favicon.svg">
  <section class="py-12 sm:py-20">
    <h1 class="mb-2 text-4xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-5xl">Blog</h1>
    <p class="mb-12 text-lg text-[var(--text-secondary)]">
      Writing about infrastructure, security, and the tools I use.
    </p>

    <div class="space-y-10">
      {posts.map((post) => (
        <article class="group border-b border-[var(--border-color)] pb-10">
          <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="block no-underline">
            <time class="text-sm text-[var(--text-secondary)]">{formatDate(post.data.date)}</time>
            <h2 class="mt-2 text-2xl font-semibold text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">
              {post.data.title}
            </h2>
            <p class="mt-3 text-[var(--text-secondary)]">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag: string) => (
                  <span class="rounded-full border border-[var(--border-color)] px-3 py-1 text-xs text-[var(--text-secondary)]">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>
